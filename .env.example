# Kakao Developers > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# Kakao Developers > 보안 > Client Secret
KAKAO_CLIENT_SECRET=
# Kakao Developers에 같은 URI를 등록하세요.
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
# 임의의 32자 이상 비밀 문자열. 운영 환경에서는 별도 값을 사용하세요.
KAKAO_SESSION_SECRET=

# AI 분석 (Python ai/ 모듈 전용). 서버 전용 Secret이므로 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 실제 값은 Git 제외 대상인 .env 또는 .env.local에만 넣으세요.
AI_API_KEY=
# OpenAI 호환 API Base URL (예: https://api.openai.com/v1)
AI_BASE_URL=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_TIMEOUT_SECONDS=30
# true면 실제 API 대신 고정 Mock 결과 사용 (현장 장애 대비)
AI_MOCK_MODE=false

# Backend(FastAPI) CORS 허용 Origin. 콤마로 구분 (비우면 localhost:3000 / 127.0.0.1:3000)
CORS_ORIGINS=

# Frontend -> FastAPI 주소 (공개값, Secret 아님). 비우면 http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=

# 저장 방식: memory(기본, 재시작 시 초기화) | supabase(DB + Storage 영구 저장)
PERSISTENCE_MODE=memory
# Supabase Dashboard > Project Settings > API (Backend 전용. NEXT_PUBLIC_ 금지)
SUPABASE_URL=
# service_role 키 또는 secret 키(sb_secret_...). 절대 Frontend/Git에 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=found-items
